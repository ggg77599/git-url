#!/bin/bash
set -e

USAGE="usage: git url [-n lineNumber] [-s] [--ssh] [[remote[/branch]] [file]]
  -n:            line number. Can specify once for single line (#L10) or twice for range (#L10-L20)
  -s:            static link, uses tag (if exists at HEAD) or commit hash instead of branch name
  --ssh:         output the SSH clone URL instead of the HTTP(S) browse URL; not usable with -n or file
  remote/branch: optional, defaults to 'origin' and current branch
  file:          optional, omit for repository or tree URL
"

# getopts only understands short flags, so peel --ssh out of the args first
ssh_flag=false
args=()
for arg in "$@"; do
    if [[ "$arg" == "--ssh" ]]; then
        ssh_flag=true
    else
        args+=("$arg")
    fi
done
set -- "${args[@]}"

# parse options
url_fragment=""
static_ref=false
while getopts ":n:sh" o; do
    case "${o}" in
    n)
        n=${OPTARG}
        if [[ -z $url_fragment ]]; then
            url_fragment="#L${n}"
        else
            url_fragment="${url_fragment}-L${n}"
        fi
        ;;
    s)
        static_ref=true
        ;;
    h)
        printf "$USAGE"
        exit 0
        ;;
    esac
done
shift $((OPTIND - 1))

remote=""
branch=""
file="$2"
if [ $# -eq 2 ]; then
    # check if the parameter is remote/branch
    if [[ "$1" == *"/"* ]]; then
        remote=${1%%/*}
        branch=${1#*/}
    else
        remote=$1
        branch=$(git rev-parse --abbrev-ref HEAD) # get current branch
    fi

    # check remote name
    if [[ "$(git remote)" != *"$remote"* ]]; then
        # FIXME: this place use contains substring, so "ori" will also pass
        echo "no such remote: $remote. $USAGE"
        exit 1
    fi

    # check branch name
    if [[ "$(git branch --remote)" != *"$remote/$branch"* ]]; then
        # FIXME: this place use contains substring, so "mas" will also pass
        echo "no such remote branch: $branch. $USAGE"
        exit 1
    fi

    # check file name
    if [ ! -f "$file" ]; then
        echo "no such file: $file. $USAGE"
        exit 1
    fi
elif [ $# -eq 1 ]; then
    if [ -f "$1" ]; then # check file name
        remote="origin"
        branch=$(git rev-parse --abbrev-ref HEAD) # get current branch
        file=$1
    elif [[ "$1" == *"/"* ]]; then # check if the parameter is remote/branch
        remote=${1%%/*}
        branch=${1#*/}
    else
        remote=$1
        branch=""
    fi

    if [[ "$(git branch --remote)" != *"$remote/$branch"* ]]; then
        # FIXME: this place use contains substring, so "mas" will also pass
        echo "no such remote branch: $branch. $USAGE"
        exit 1
    fi

elif [ $# -eq 0 ]; then
    remote="origin"
else
    echo "parameter incorrect. $USAGE"
    exit 1
fi

# --ssh only makes sense as a bare clone URL; line numbers and file paths are HTTP-browse concepts
if [ "$ssh_flag" = true ] && { [ -n "$url_fragment" ] || [ -n "$file" ]; }; then
    echo "-n and file are not supported with --ssh. $USAGE"
    exit 1
fi

# if static ref is requested, replace branch with tag or commit hash
if [ "$static_ref" = true ] && [ -n "$branch" ]; then
    # try to get the tag pointing to HEAD
    tag=$(git tag --points-at HEAD | head -n 1)
    if [ -n "$tag" ]; then
        branch="$tag"
    else
        # fallback to commit hash
        branch=$(git rev-parse HEAD)
    fi
fi

if [ "$ssh_flag" = true ]; then
    # keep the .git suffix: this is the clone URL itself, not a browse-URL base
    remote_url=$(git remote get-url "$remote")
else
    remote_url=$(git remote get-url "$remote" | sed 's/\.git$//g')
fi

# Resolve SSH host from ~/.ssh/config
if [[ "$remote_url" =~ ^(ssh://)?git@([^:/]+) ]]; then
    ssh_host="${BASH_REMATCH[2]}"
    real_hostname=$(ssh -G "$ssh_host" 2> /dev/null | awk '$1 == "hostname" { print $2 }')
    if [ -n "$real_hostname" ]; then
        remote_url="${remote_url/@$ssh_host/@$real_hostname}"
    fi
fi

# --ssh skips the HTTP(S) conversion below entirely and ignores branch/file
if [ "$ssh_flag" = true ]; then
    echo "$remote_url"
    exit 0
fi

# GIT_URL_SPECIAL_RULES: "host:oldport:newport;host2:oldport2:newport2;...".
# Lets self-hosted remotes on a non-standard SSH port map to their HTTPS port
# without hardcoding a hostname in this script. Unset -> no special rule applies.
special_oldport=""
special_newport=""
if [ -n "$GIT_URL_SPECIAL_RULES" ]; then
    IFS=';' read -ra special_rules <<< "$GIT_URL_SPECIAL_RULES"
    for rule in "${special_rules[@]}"; do
        [ -z "$rule" ] && continue
        rule_host="${rule%%:*}"
        rule_ports="${rule#*:}"
        rule_oldport="${rule_ports%%:*}"
        rule_newport="${rule_ports#*:}"
        if [[ "$remote_url" == *"${rule_host}:${rule_oldport}"* ]]; then
            special_oldport="$rule_oldport"
            special_newport="$rule_newport"
            break
        fi
    done
fi

if [[ "$remote_url" == "git@"* ]]; then
    #echo "start with git@"
    remote_url=$(echo "$remote_url" | sed 's|:|/|g')
    remote_url=$(echo "$remote_url" | sed 's|git@|https://|g')
elif [[ "$remote_url" == "ssh://git@"* ]]; then
    #echo "start with ssh://git@"
    remote_url=$(echo "$remote_url" | sed 's|^ssh://||g')
    remote_url=$(echo "$remote_url" | sed 's|:|/|g')
    remote_url=$(echo "$remote_url" | sed 's|git@|https://|g')
elif [[ -n "$special_oldport" ]]; then
    #echo "special rules"
    remote_url=$(echo "$remote_url" | sed "s|${special_oldport}|${special_newport}|g")
    remote_url=$(echo "$remote_url" | sed 's|ssh://git@|https://|g')
fi

if [[ -z $branch && -z "$file" ]]; then
    echo "$remote_url"
elif [ "$file" = "" ]; then
    echo "${remote_url}/tree/${branch}"
else
    relative_file_path=$(git ls-files --full-name "$file")
    if [[ -n "$url_fragment" ]] && [[ "$relative_file_path" =~ \.(md|markdown|MD|MARKDOWN)$ ]]; then
        echo "${remote_url}/blob/${branch}/${relative_file_path}?plain=1${url_fragment}"
    else
        echo "${remote_url}/blob/${branch}/${relative_file_path}${url_fragment}"
    fi
fi
